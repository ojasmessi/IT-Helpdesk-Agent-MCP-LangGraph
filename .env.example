# Copy this file to .env and fill in your key. NEVER commit .env to GitHub.
OPENAI_API_KEY=sk-...

# Which LLM to use, as "provider:model". Any LangChain-supported model works.
MODEL=openai:gpt-4.1-mini

# Optional: connect to an MCP server already running over HTTP instead of
# starting it as a subprocess. Start it with:  python mcp_server/helpdesk_server.py http
# MCP_URL=http://localhost:8000/mcp
