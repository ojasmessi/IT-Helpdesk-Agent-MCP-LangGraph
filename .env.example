# Copy this file to .env and fill in your key. NEVER commit .env to GitHub.
OPENAI_API_KEY=sk-...

# Which LLM to use, as "provider:model". Any LangChain-supported model works.
MODEL=openai:gpt-4.1-mini

# --- MCP server connection (used by the server AND every client) ---
# Transport: sse (default) or streamable_http (newer MCP transport, served at /mcp)
MCP_TRANSPORT=sse
MCP_HOST=127.0.0.1
# 8001 so it doesn't clash with Chainlit, which uses 8000
MCP_PORT=8001
# Optional: full URL of a server running elsewhere (overrides host/port), e.g.
# MCP_URL=http://192.168.1.50:8001/sse
